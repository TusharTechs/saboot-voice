{
  "name": "saboot-voice",
  "version": "0.1.0",
  "private": true,
  "description": "A voice harness for Indian support calls: gets numbers, IDs, pincodes and names right in Hinglish, and doesn't cut callers off mid-number.",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "vite --config vite.config.ts",
    "server": "tsx src/server/dev.ts",
    "build": "vite build --config vite.config.ts",
    "clips": "tsx eval/make-clips.ts",
    "eval": "tsx eval/run.ts",
    "report": "tsx eval/report.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
